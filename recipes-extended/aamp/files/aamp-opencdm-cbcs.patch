 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/drm/AampOcdmBasicSessionAdapter.cpp b/drm/AampOcdmBasicSessionAdapter.cpp
index bd30d53d86..730d908fb7 100755
--- a/drm/AampOcdmBasicSessionAdapter.cpp
+++ b/drm/AampOcdmBasicSessionAdapter.cpp
@@ -31,9 +31,13 @@ int AAMPOCDMBasicSessionAdapter::decrypt(const uint8_t *f_pbIV, uint32_t f_cbIV,
 		dataToSend = vdata.data();
 	}
 
+	EncryptionScheme encScheme = AesCtr_Cenc;
+	EncryptionPattern pattern = {0};
+
 	int retvalue = opencdm_session_decrypt(m_pOpenCDMSession,
 										   dataToSend,
 										   sizeToSend,
+										   encScheme, pattern,
 										   f_pbIV, f_cbIV,
 										   m_keyId.data(), m_keyId.size());
 	if (retvalue != 0)
diff --git a/drm/AampOcdmGstSessionAdapter.cpp b/drm/AampOcdmGstSessionAdapter.cpp
index 0baa73cf97..7dda228e74 100755
--- a/drm/AampOcdmGstSessionAdapter.cpp
+++ b/drm/AampOcdmGstSessionAdapter.cpp
@@ -368,7 +368,9 @@ int AAMPOCDMGSTSessionAdapter::decrypt(const uint8_t *f_pbIV, uint32_t f_cbIV, c
 
 		pthread_mutex_lock(&decryptMutex);
 		start_decrypt_time = GetCurrentTimeStampInMSec();
-		retValue = opencdm_session_decrypt(m_pOpenCDMSession, (uint8_t *)payloadData, payloadDataSize, f_pbIV, f_cbIV, NULL, 0, 0);
+		EncryptionScheme encScheme = AesCtr_Cenc;
+		EncryptionPattern pattern = {0};
+		retValue = opencdm_session_decrypt(m_pOpenCDMSession, (uint8_t *)payloadData, payloadDataSize, encScheme, pattern, f_pbIV, f_cbIV, NULL, 0, 0);
 		end_decrypt_time = GetCurrentTimeStampInMSec();
 		if (retValue != 0)
 		{
